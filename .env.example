# Optional — without a key the agent uses a deterministic local planner (good for CI / QA demos)
OPENAI_API_KEY=

# openai | local
AGENT_MODE=local

OPENAI_MODEL=gpt-4o-mini
HOST=127.0.0.1
PORT=8002

# SQLite (users, orders, tickets)
DATABASE_PATH=data/qa_ai.db

# Jira Cloud (optional). Create API token at:
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=KAN
JIRA_ISSUE_TYPE=Story

# When true, Playwright creates a Jira issue for each failed/timedOut test
JIRA_ON_TEST_FAILURE=false
